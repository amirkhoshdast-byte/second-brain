# ============================================================
# مغز دوم سازمانی — متغیرهای محیطی
# این فایل را به .env کپی کنید و مقادیر را تنظیم کنید
# ============================================================

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=orgplatform
POSTGRES_USER=orgplatform
POSTGRES_PASSWORD=change-me-strong-password

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant-key

# Embedding
EMBEDDING_MODEL=bge-m3
QDRANT_COLLECTION=org_documents_bge

# داشبورد
APP_PASSWORD=change-me-dashboard-password
AUTH_SECRET=change-me-64-char-random-string-use-openssl-rand-hex-32

# Ollama
OLLAMA_HOST=http://localhost:11434
EXTRACT_MODEL=qwen3:8b

# مسیر Vault
VAULT_PATH=/Users/YOUR_USERNAME/Documents/My Second Brain/Cultural Intelligence Hub

# n8n (اختیاری)
N8N_USER=admin
N8N_PASSWORD=change-me-n8n-password

# Redis (اختیاری)
REDIS_PASSWORD=change-me-redis-password

# WebUI (اختیاری)
WEBUI_SECRET_KEY=change-me-webui-key
